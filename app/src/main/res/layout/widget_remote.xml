<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="10dp">

    <TextView android:id="@+id/w_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="4dp" android:paddingBottom="6dp"
        android:text="Remot Canggih" android:textColor="#FFF2F0EC" android:textSize="13sp" android:textStyle="bold" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal">
        <ImageView android:id="@+id/w_power" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/widget_power"
            android:scaleType="center" android:src="@drawable/ic_w_power" android:contentDescription="Power" />
        <ImageView android:id="@+id/w_mute" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/widget_key"
            android:scaleType="center" android:src="@drawable/ic_w_mute" android:contentDescription="Bisukan" />
        <ImageView android:id="@+id/w_home" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/widget_key"
            android:scaleType="center" android:src="@drawable/ic_w_home" android:contentDescription="Home" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal">
        <ImageView android:id="@+id/w_voldown" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/widget_key"
            android:scaleType="center" android:src="@drawable/ic_w_minus" android:contentDescription="Volume turun" />
        <ImageView android:id="@+id/w_play" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/widget_accent"
            android:scaleType="center" android:src="@drawable/ic_w_play" android:contentDescription="Putar atau jeda" />
        <ImageView android:id="@+id/w_volup" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/widget_key"
            android:scaleType="center" android:src="@drawable/ic_w_plus" android:contentDescription="Volume naik" />
    </LinearLayout>
</LinearLayout>
